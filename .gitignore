# Local .terraform directories (contains provider binaries and modules)
.terraform/

# .tfstate files (contains sensitive cleartext infrastructure state)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (likely to contain sensitive passwords, API keys, and secrets)
*.tfvars
*.tfvars.json

# Ignore override files (used for quick local modifications)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created during terraform apply
.terraform.tfstate.lock.info

# Ignore CLI configuration files
.terraformrc
terraform.rc
